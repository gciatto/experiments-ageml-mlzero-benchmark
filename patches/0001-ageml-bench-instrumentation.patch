+            "model": model,
+            "base_url": kwargs.get("openai_api_base"),
+            "env_base_url": os.environ.get("OPENAI_BASE_URL"),
+            **{k: kwargs.get(k) for k in ("temperature", "top_p", "max_tokens", "reasoning_effort")},
+        },
+    )
     return AssistantChatOpenAI(**kwargs)
