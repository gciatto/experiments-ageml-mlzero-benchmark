@@ -24,8 +24,14 @@ class AssistantChatOpenAI(ChatOpenAI, BaseAssistantChat):
 
 def get_openai_models() -> List[str]:
     try:
+        # OPENAI_BASE_URL is honoured by OpenAI(); ageml-bench sets it to the same
+        # endpoint as proxy_url so discovery and chat agree. Non-OpenAI
+        # endpoints (e.g. Google's compatibility layer) list every model, with
+        # the "models/" prefix stripped, instead of OpenAI-only prefixes.
         client = OpenAI()
         models = client.models.list()
+        if os.environ.get("OPENAI_BASE_URL"):
+            return [model.id.removeprefix("models/") for model in models]
         return [model.id for model in models if model.id.startswith(("gpt-3.5", "gpt-4", "o1", "o3"))]
     except Exception as e:
         logger.error(f"Error fetching OpenAI models: {e}")
@@ -56,4 +62,22 @@ def create_openai_chat(config, session_name: str) -> AssistantChatOpenAI:
     if hasattr(config, "proxy_url"):
         kwargs["openai_api_base"] = config.proxy_url
 
+    # ageml-bench: forward sampling/reasoning settings that upstream drops
+    if config.get("top_p") is not None:
+        kwargs["top_p"] = config.top_p
+    if config.get("reasoning_effort") is not None:
+        kwargs["reasoning_effort"] = config.reasoning_effort
+
+    from .. import bench_hooks
+
+    bench_hooks.chat_created(
