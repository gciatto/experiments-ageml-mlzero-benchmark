new file mode 100644
index 0000000..814f0c3
--- /dev/null
+++ b/src/autogluon/assistant/bench_hooks.py
@@ -0,0 +1,106 @@
+"""ageml-bench instrumentation. Every hook is a no-op unless AGEML_BENCH_DIR is set.
+
+Writes, under $AGEML_BENCH_DIR:
+  events.jsonl          one line per chat creation, search step, commit, stop
+  usage.jsonl           one line per completed LLM call, raw provider usage
+  effective_config.yaml the config handed to NodeManager, after CLI overrides
+  incumbent.json        the native selected candidate at the last committed
+                        successful-step boundary (atomic replace)
+"""
+
+import json
+import os
+import tempfile
+import time
+
+BENCH_DIR = os.environ.get("AGEML_BENCH_DIR")
+EXPORT_ENTRY_POINT = "predict.py"
+
+
+def _append(name, obj):
+    if not BENCH_DIR:
+        return
+    obj = {"ts": time.time(), **obj}
+    with open(os.path.join(BENCH_DIR, name), "a") as f:
+        f.write(json.dumps(obj, default=str) + "\n")
+        f.flush()
+        os.fsync(f.fileno())
+
+
+def _atomic_write(name, text):
+    fd, tmp = tempfile.mkstemp(dir=BENCH_DIR, prefix=f".{name}.")
+    with os.fdopen(fd, "w") as f:
+        f.write(text)
+        f.flush()
+        os.fsync(f.fileno())
+    os.replace(tmp, os.path.join(BENCH_DIR, name))
+
+
+def event(kind, **data):
+    _append("events.jsonl", {"event": kind, **data})
+
+
+def chat_created(session_name, settings):
+    event("chat_created", session=session_name, settings=settings)
+
+
+def llm_call(session_name, ai_message):
+    usage = getattr(ai_message, "usage_metadata", None)
+    meta = getattr(ai_message, "response_metadata", None) or {}
+    _append(
+        "usage.jsonl",
+        {
+            "session": session_name,
+            "reported_model": meta.get("model_name") or meta.get("model"),
+            "usage_metadata": dict(usage) if usage else None,
+            "token_usage": meta.get("token_usage"),
+        },
+    )
+
+
+def effective_config(config, **cli):
+    if not BENCH_DIR:
+        return
+    from omegaconf import OmegaConf
+
+    _atomic_write("effective_config.yaml", OmegaConf.to_yaml(config, resolve=True))
+    event("effective_config", cli=cli)
+
+
+def step(manager, success):
+    node = getattr(manager, "current_node", None)
+    event(
+        "step",
+        time_step=getattr(manager, "time_step", None),
+        node_id=getattr(node, "id", None),
+        stage=getattr(node, "stage", None),
+        success=success,
+        validation_score=getattr(node, "validation_score", None),
+        tool=getattr(node, "tool_used", None),
+    )
+
+
+def commit_incumbent(manager):
+    """Publish the native selection made by create_best_run_copy (same rule)."""
+    if not BENCH_DIR:
+        return
+    node = manager._best_node or manager.last_successful_node
+    if node is None:
+        return
+    folder = manager.get_iteration_folder(node)
+    output = os.path.join(folder, "output")
+    record = {
+        "node_id": node.id,
+        "selected_by": "best_validation_score" if manager._best_node else "last_successful",
+        "native_validation_score": node.validation_score,
+        "node_folder": folder,
+        "output_folder": output,
+        "export_status": "present"
+        if os.path.isfile(os.path.join(output, EXPORT_ENTRY_POINT))
+        else "missing",
+        "tool": node.tool_used,
+        "time_step": manager.time_step,
+        "committed_at": time.time(),
+    }
+    _atomic_write("incumbent.json", json.dumps(record, indent=2, default=str))
+    event("incumbent_committed", **record)
